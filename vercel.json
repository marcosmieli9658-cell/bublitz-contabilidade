{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist-pages",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.bublitzcontabilidade.com.br" }],
      "destination": "https://bublitzcontabilidade.com.br/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "bublitz-contabilidade.vercel.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
